{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "makayla-jobs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "makayla-jobs.jarenkempton.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makayla-jobs",
      "database_id": "c958083c-ed4d-4fb8-bacd-0994d7345ced",
      "migrations_dir": "drizzle",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "access": {
    "dev": {
      "aud": "local-development",
      "identity": {
        "email": "developer@localhost",
      },
    },
  },
  "vars": {
    "ACCESS_AUD": "9a76c53c101527b3b79fc750ea135e28d367a1584420402e35fb14d9b00514b7",
    "ACCESS_TEAM_DOMAIN": "https://jarenkempton.cloudflareaccess.com",
  },
}
