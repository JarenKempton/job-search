{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-search",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "job-search.jarenkempton.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },
  "ai": { "binding": "AI", "remote": true },
  "triggers": { "crons": ["1 0 * * *"] },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["jobs@jarenkempton.dev"],
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TRACKER", "class_name": "Tracker" },
      { "name": "DIRECTORY", "class_name": "Directory" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Tracker"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "access": {
    "dev": {
      "aud": "local-development",
      "identity": {
        "email": "developer@localhost",
      },
    },
  },
  "vars": {
    "ACCESS_AUD": "ddc62324f80b4fde42600f5819fb6c463357a1267e6ee81a50e116d9d00070e4",
    "ACCESS_TEAM_DOMAIN": "https://jarenkempton.cloudflareaccess.com",
    "ADMIN_EMAILS": "jaren.kempton@gmail.com",
    "CLOUDFLARE_ACCOUNT_ID": "14724deda231baae703a1ef41a4ba29b",
    "INVITE_FROM": "jobs@jarenkempton.dev",
    "ACCESS_GROUP_ID": "f94cb8ec-25f2-4d2a-a46d-5bf786b03443",
  },
}
