{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-search",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "job-search.jarenkempton.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-search",
      "database_id": "2e7178b9-1f85-4d17-a47a-17e8374d5ecd",
      "migrations_dir": "drizzle",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "access": {
    "dev": {
      "aud": "local-development",
      "identity": {
        "email": "developer@localhost",
      },
    },
  },
  "vars": {
    "ACCESS_AUD": "ddc62324f80b4fde42600f5819fb6c463357a1267e6ee81a50e116d9d00070e4",
    "ACCESS_TEAM_DOMAIN": "https://jarenkempton.cloudflareaccess.com",
    "ACCESS_SERVICE_CLIENT_ID": "bb2fd392a5c7240d1214679a2f96ca9c.access",
  },
}
